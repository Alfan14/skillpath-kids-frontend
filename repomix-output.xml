              <tbody className="divide-y divide-[#d4e3ff]">
                {loading && !data ? (
                  Array.from({ length: 5 }).map((_, index) => (
                    <tr key={index}>
                      <td className="px-6 py-4" colSpan={4}>
                        <div className="h-10 animate-pulse rounded-xl bg-[#d4e3ff]/55" />
