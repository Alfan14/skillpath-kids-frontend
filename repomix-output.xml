    swatch: '#96f89f',
  },
  {
    value: 'bg-[#ffe173]',
    label: 'Soft Yellow',
    bg: 'bg-[#ffe173]',
    fg: 'text-[#0f1d24]',
    swatch: '#ffe173',
  },
  {
    value: 'bg-[#ffd6d6]',
    label: 'Soft Red',
    bg: 'bg-[#ffd6d6]',
    fg: 'text-[#b91c1c]',
    swatch: '#ffd6d6',
  },
  {
