                  onClick={() => setPage((current) => current + 1)}
                >
                  Berikutnya
                  <ChevronRight className="h-4 w-4" aria-hidden="true" />
                </Button>
              </div>
            </div>
          )}
        </section>
      )}

      {selectedAssessment && (
        <AssessmentDetailModal
          item={selectedAssessment}
          onClose={() => setSelectedAssessment(null)}
        />
      )}
    </div>
  );
}

