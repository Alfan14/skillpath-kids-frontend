                Teacher Resource
              </BadgePill>
              <BadgePill className="bg-[#ffe173] text-[#0f1d24]">
                Materi Kelas
              </BadgePill>
            </div>
            <h1 className="text-3xl font-black leading-tight text-[#004883] md:text-4xl">
