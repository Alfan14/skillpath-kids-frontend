          {badge.date}
        </span>
      ) : (
        <span className="mt-auto inline-flex items-center rounded-full bg-[#ffe173] px-3 py-1 text-xs font-extrabold text-[#0f1d24]">
          Selesaikan aktivitas
        </span>
      )}
    </motion.article>
  );
};
