                      </td>
                      <td className="px-5 py-4">
                        <span className="inline-flex whitespace-nowrap items-center gap-2 text-xs font-bold text-on-surface-variant">
                          <CalendarDays className="h-4 w-4" aria-hidden="true" />
                          {formatDate(item.createdAt)}
